# Copy to .env and fill in. .env is gitignored: it holds private calendar links, the panel PIN
# and API tokens. Never commit it.

# --- Server -----------------------------------------------------------------------
# The panels fetch their frames from http://<this machine>:PORT, so PUBLIC_HOST must be this
# machine's LAN IP as the panels see it (auto-detection fails inside Docker).
PORT=8080
PUBLIC_HOST=192.168.1.50
# Or the full base URL when this runs behind an Ingress or proxy (overrides PUBLIC_HOST and PORT):
# PUBLIC_URL=https://calendar.example.internal

# Which day it is, and how event times are shown.
TIMEZONE=America/New_York

# --- Calendars --------------------------------------------------------------------
# Preferred: list any number of calendars in config/config.yaml (copy config/config.example.yaml). In Docker
# the config/ folder is mounted at /config. A link in that file can refer to a variable here as "${NAME}":
# PERSONAL_ICAL_URL=https://calendar.google.com/calendar/ical/you%40gmail.com/private-XXXX/basic.ics
#
# Without a config file, list ids here and configure each. Google Calendar: Settings > the calendar >
# "Integrate calendar" > "Secret address in iCal format". That link is a password (anyone with it can read
# the calendar): keep it only in .env or the config file. Holiday calendars have a public link.
CALENDARS=personal,family,holidays

CALENDAR_PERSONAL_URL=https://calendar.google.com/calendar/ical/you%40gmail.com/private-XXXX/basic.ics
CALENDAR_PERSONAL_NAME=Me
CALENDAR_PERSONAL_COLOR=blue

CALENDAR_FAMILY_URL=https://calendar.google.com/calendar/ical/family0000%40group.calendar.google.com/private-XXXX/basic.ics
CALENDAR_FAMILY_COLOR=red

CALENDAR_HOLIDAYS_URL=https://calendar.google.com/calendar/ical/en.usa%23holiday%40group.v.calendar.google.com/public/basic.ics
CALENDAR_HOLIDAYS_NAME="US Holidays"
CALENDAR_HOLIDAYS_COLOR=black

# NAME is optional (default: the calendar's own name). COLOR is one of the panel's inks:
# red | green | blue | yellow | black (default: assigned in order). A calendars list in the config file
# replaces CALENDARS and CALENDAR_* entirely.

# How long a fetched calendar is reused (seconds), and how often a frame is rendered.
# CALENDAR_FETCH_SECONDS=600
# REFRESH_INTERVAL_SECONDS=900
# In REDRAW_MODE=auto the panel is redrawn only when the picture changed, but at least this often (seconds).
# FORCE_PUSH_SECONDS=21600

# --- When the panel is redrawn -------------------------------------------------------
# auto (default): this server redraws as soon as it sees a change (checked every REFRESH_INTERVAL_SECONDS).
# manual: it only notices ("redraw pending") and waits to be told, by Home Assistant over MQTT or by
#         POST /api/displays/<id>/refresh. Nothing is redrawn on a timer.
# REDRAW_MODE=manual
# Remember what the panel shows across restarts (so a restart does not redraw it). In Docker, mount a volume.
# STATE_FILE=/data/state.json

# --- Layout ---------------------------------------------------------------------------------
# paper | timeline. Per display: DISPLAY_<ID>_LAYOUT. Home Assistant can switch it live.
# LAYOUT=paper

# --- Theme -------------------------------------------------------------------------------------
# auto (default): the theme follows the date: a holiday window (Easter week, Halloween, Christmas ...) if one holds today, else
# the month's own design. none: no theming. A name: that theme all year. Per display: DISPLAY_<ID>_THEME. Home Assistant can
# switch it live. Your own schedule, windows and themes go in the `themes:` section of config/config.yaml.
# THEME=auto
# A month's design (a theme name or none), overriding the default; the config file's `themes.months` wins over these:
# THEME_APR=spring
# THEME_OCT=none

# --- Home Assistant (MQTT) -------------------------------------------------------------
# Publishes a device with sensors and buttons through MQTT discovery. Leave unset to turn it off.
# MQTT_URL=mqtt://192.168.1.10:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_TOPIC_PREFIX=samsung-epaper-calendar

# --- Shopping list ----------------------------------------------------------------
# none (default) | file | googletasks   (see docs/CONFIGURATION.md)
SHOPPING_SOURCE=none
# SHOPPING_TITLE=Shopping
# file:
# SHOPPING_FILE=/data/shopping.json
# googletasks (run `node scripts/google-auth.mjs` once to get the refresh token):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_TASKS_LIST=Shopping

# --- Display ----------------------------------------------------------------------
# With DISPLAY_HOST/PIN unset the server only renders and serves ("serve-only").
# DISPLAY_HOST=192.168.1.123
# DISPLAY_PIN=123456
# Master switch: false disables every push.
# MDC_PUSH_ENABLED=false

# --- A panel on battery: waking and sleeping (see docs/CONFIGURATION.md; run `npm run probe` first) ---------
# The panel's WI-FI MAC. Needed to wake it; with it set, waking is on. The panel must have
# Network Standby turned on.
# DISPLAY_MAC=00:11:22:33:44:55
# DISPLAY_BROADCAST=192.168.1.255        # default: the panel IP's /24
# DISPLAY_SLEEP_AFTER_PUSH=true          # turn on only after the probe's --sleep-test works
# DISPLAY_SLEEP_ON_EXTERNAL_POWER=false  # sleep even on USB or AC power
# DISPLAY_PANEL_SLEEPS_AFTER_CONTENT=true  # set this if you turned on the panel's own "sleep immediately after receiving content"
# DISPLAY_SETTLE_SECONDS=45              # let the e-paper refresh before it is put to sleep
# DISPLAY_WAKE_TIMEOUT_SECONDS=45
# DISPLAY_FETCH_TIMEOUT_SECONDS=60
# DISPLAY_BATTERY_CHECK_HOURS=24         # wake it this often just to read the battery (0 = never)
# DISPLAY_AUTO_SLEEP_MINUTES=20          # the panel sleeps by itself this long after waking (seen: 20)

# Image size the panel's firmware mode expects, and the rotation applied when encoding. A panel in
# portrait mode takes 1440x2560 with rotation 0 (the default here); a panel left in its native
# landscape mode (2560x1440) takes OUTPUT_ROTATION=90 with PANEL_WIDTH=2560, PANEL_HEIGHT=1440.
# PANEL_WIDTH=1440
# PANEL_HEIGHT=2560
# OUTPUT_ROTATION=0

# Several panels showing the same calendar (or a `displays:` list in config/config.yaml):
# DISPLAYS=kitchen,hall
# DISPLAY_HALL_LAYOUT=timeline
# DISPLAY_KITCHEN_HOST=192.168.1.123
# DISPLAY_HALL_HOST=192.168.1.124
# DISPLAY_HALL_ROTATION=180

# Your own header, footer and motif PNGs for the themes are looked for in THEMES_DIR, /config/themes, ./config/themes and
# the project's themes/ folder (see themes/README.md):
# THEMES_DIR=/config/themes

# The timeline layout's hour-by-hour view of today, kept readable on a long or crowded day:
# TIMELINE_AMBIENT_HOURS=24  a timed event this long or longer (a 24/7 gym: a whole day) becomes an all-day chip, not a block (0: off)
# TIMELINE_BREAK_HOURS=3     fold a run of this many empty hours into one thin break (0: draw every hour). If the hours still cannot be
#                            drawn legibly (blocks under an hour tall, or more than six overlapping at once), the day is listed instead.

# Frames are reduced to the panel's six exact inks and sent as PNG. (JPEG blurs those colors.)
# IMAGE_FORMAT=png
# How theme art reaches the panel. Text, lines and boxes are exact inks in every mode.
#   panel (default)  the art is sent in true color and the panel's own dithering mixes the inks (a true-color PNG)
#   pattern          we mix the six inks ourselves into clean regular tiles (a six-color PNG)
#   diffusion        we mix them by error diffusion (finer, noisier)
# /preview?art=pattern shows the other modes without changing this.
# ART_DITHER=panel
# How the antialiased edges of text and shapes reach the panel:
#   panel (default)  true in-between colors; the panel's own dithering resolves them (best on a real EM32DX)
#   threshold        a pixel is ink if TEXT_CUT (default 0.4) of it is covered: every pixel is exactly one of six inks
#   dither           ink in proportion to coverage, as a halftone: also six inks only
# TEXT_AA=panel
# TEXT_CUT=0.4
# What your panel's inks really look like, used only to decide how to mix them when dithering theme art:
# PANEL_PALETTE={"red":"#8a1c0c","blue":"#1d3f8a"}
